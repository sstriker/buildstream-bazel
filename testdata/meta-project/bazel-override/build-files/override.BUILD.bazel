# Operator-supplied BUILD for the `override` element. Looked up
# by --build-files-dir at <dir>/<elem.Name>.BUILD.bazel; the
# matching .bst declares kind:manual but the override flips it
# to kind:bazel and write-a emits this file verbatim into
# project B's elements/override/BUILD.bazel.
load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "override",
    srcs = ["greet.c"],
    visibility = ["//visibility:public"],
)
