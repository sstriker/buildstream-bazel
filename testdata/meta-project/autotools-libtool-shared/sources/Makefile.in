CC ?= cc
CFLAGS = @CFLAGS@
prefix = @PREFIX@
libdir = $(prefix)/lib
includedir = $(prefix)/include

# Real-libtool emulation. Mirrors what libtool's link mode
# actually emits when an autotools project declares
# `lib_LTLIBRARIES = libfoo.la`:
#
#   1. PIC compile -> .libs/foo.o (already exercised by
#      autotools-libtool-pic).
#   2. Non-PIC compile -> foo.o (same).
#   3. Shared link -> .libs/libfoo.so.0.0.0 via cc -shared.
#      The converter must IGNORE this event — Bazel's
#      cc_library produces the matching shared output on
#      the consumer side, so emitting it as a cc_binary
#      named "libfoo.so.0.0.0" would be a duplicate at best
#      and a name collision with the cc_library "foo" at
#      worst.
#   4. Static archive -> .libs/libfoo.a via ar/ranlib.
#      This is what the converter recovers as the cc_library.
#   5. libfoo.la text file written by the recipe (libtool
#      writes this directly; no execve in the cc family).
#      It DOES appear in the install recipe — install-mapping
#      should capture the .la entry but won't have a rule
#      cross-ref (it's metadata, not a buildable artifact).
#
# The point of this fixture: assert that with a real-libtool-
# shaped trace, the converter recovers exactly ONE cc_library
# (foo) and zero spurious cc_binary rules for the .so.

all: .libs/libfoo.a libfoo.la

.libs/foo.o: foo.c foo.h
	@mkdir -p .libs
	$(CC) $(CFLAGS) -fPIC -DPIC -c foo.c -o .libs/foo.o

foo.o: foo.c foo.h
	$(CC) $(CFLAGS) -c foo.c -o foo.o

# cc -shared emits the versioned .so. The actual call shape
# matches what libtool-mode=link emits.
.libs/libfoo.so.0.0.0: .libs/foo.o
	$(CC) -shared -Wl,-soname,libfoo.so.0 -o .libs/libfoo.so.0.0.0 .libs/foo.o
	cd .libs && ln -sf libfoo.so.0.0.0 libfoo.so.0
	cd .libs && ln -sf libfoo.so.0.0.0 libfoo.so

# ar+ranlib gives the static archive that the converter picks
# up for cc_library recovery.
.libs/libfoo.a: foo.o
	@mkdir -p .libs
	ar cru .libs/libfoo.a foo.o
	ranlib .libs/libfoo.a

# libtool's text-archive metadata file. Hand-written to mirror
# real libtool's output: libname/dlname/library_names + the
# inherited_linker_flags + dependency_libs fields. Not parsed
# by the converter; the install-mapping should still capture
# it.
libfoo.la: .libs/libfoo.so.0.0.0 .libs/libfoo.a
	@printf '%s\n' \
	    "# libfoo.la - a libtool library file" \
	    "# Generated by libtool emulation" \
	    "dlname='libfoo.so.0'" \
	    "library_names='libfoo.so.0.0.0 libfoo.so.0 libfoo.so'" \
	    "old_library='libfoo.a'" \
	    "inherited_linker_flags=''" \
	    "dependency_libs=''" \
	    "current=0" "age=0" "revision=0" \
	    "installed=yes" \
	    "shouldnotlink=no" \
	    "dlopen=''" "dlpreopen=''" \
	    "libdir='$(libdir)'" \
	    > libfoo.la

install: all
	install -D -m 0644 .libs/libfoo.a $(DESTDIR)$(libdir)/libfoo.a
	install -D -m 0755 .libs/libfoo.so.0.0.0 $(DESTDIR)$(libdir)/libfoo.so.0.0.0
	install -D -m 0644 libfoo.la $(DESTDIR)$(libdir)/libfoo.la
	install -D -m 0644 foo.h $(DESTDIR)$(includedir)/foo.h
	cd $(DESTDIR)$(libdir) && ln -sf libfoo.so.0.0.0 libfoo.so.0
	cd $(DESTDIR)$(libdir) && ln -sf libfoo.so.0.0.0 libfoo.so

clean:
	rm -rf *.o *.a *.la .libs

.PHONY: all install clean
