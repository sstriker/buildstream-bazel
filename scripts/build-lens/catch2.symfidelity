# Symbol-fidelity lens config for Catch2 (7th survey lens, SURVEY_SYMBOL_FIDELITY).
# The survey lens reuses the build lens's SPLIT artifact (where Catch2's generated
# version header is wired natively), so no convert flags are needed here — unlike
# the mono CI path. cmake's target/artifact: Catch2 / libCatch2.a.
SYMFID_TARGET=Catch2
SYMFID_ARTIFACT=libCatch2.a
