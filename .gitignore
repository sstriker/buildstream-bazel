# Build outputs
build/
# Bazel symlink trees at the repo root (bazel-bin, bazel-out, bazel-testlogs).
# Anchored to the root so testdata directories like
# orchestrator/testdata/bazel-downstream/ aren't swept up.
/bazel-*

# Test outputs
*.test
coverage.out
coverage.html

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code worktree dir — per-agent isolated working trees
# spawned by the harness, never committed to history.
.claude/

# Local convert-element outputs
out/
tmp/

# Local checkouts of fetched sample projects (libdrm etc.)
converter/testdata/sample-projects/libdrm/

# write-a binary built at the repo root by `go build ./cmd/write-a`.
# Anchored so cmd/write-a/ directory contents aren't swept up.
/write-a

# Converter command binaries built at the repo root by
# `go build ./converter/cmd/<name>`. Anchored so the per-binary
# source directories under converter/cmd/ aren't swept up.
/convert-element
/convert-element-meson
/convert-element-pyproject
/derive-toolchain
/probe-cell
/probe-cell-fixture
/render-project-a
/unify-toolchains

# Defensive: prevent stray binaries built into the repo root
# when developers run `go build ./cmd/...` without an -o flag
# (the canonical path is build/bin/<name> per Makefile).
/build-cc-index
/relax-keeps
/stage-b
/write-a
/convert-element
/convert-element-meson
/convert-element-pyproject
/convert-element-trace
/build-tracer
